# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="ar"
NODE_ENV="development"

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kids_arabic_academy?schema=public"

# Authentication & Security
AUTH_SECRET="kids-arabic-academy-dev-secret-key-32-chars-minimum"
NEXTAUTH_URL="http://localhost:3000"

# Storage
STORAGE_PROVIDER="MOCK"
STORAGE_ENDPOINT="https://mock.storage.internal"
STORAGE_ACCESS_KEY_ID="mock-key"
STORAGE_SECRET_ACCESS_KEY="mock-secret"
STORAGE_BUCKET_NAME="kids-arabic-academy-private"

# Virtual Classrooms
MEETING_PROVIDER="MOCK"

# Payments
PAYMENT_PROVIDER="MOCK"

# Stripe (required for real checkout/billing — leave PAYMENT_PROVIDER=MOCK if unset)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
