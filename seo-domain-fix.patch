From 3e374c058465d19864c6db582b9b84d56f9b4b99 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Mon, 14 Sep 2026 11:06:32 +0000
Subject: [PATCH] fix(seo): correct fallback domain in robots.ts and sitemap.ts

The NEXT_PUBLIC_SITE_URL fallback still pointed at the old
kidsarabicacademy.com domain, so robots.txt and sitemap.xml served the
wrong canonical domain whenever that env var isn't set. This was the
one Phase 00 item not already covered by PR #2 (P0 auth hardening).

Co-Authored-By: Claude Sonnet 5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Lw4NFHTzoDtcYLQxEsUX8Q
---
 src/app/robots.ts  | 2 +-
 src/app/sitemap.ts | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/src/app/robots.ts b/src/app/robots.ts
index 4204b18..6765bab 100644
--- a/src/app/robots.ts
+++ b/src/app/robots.ts
@@ -1,7 +1,7 @@
 import { MetadataRoute } from "next";
 
 export default function robots(): MetadataRoute.Robots {
-  const baseUrl = process.env.NEXT_PUBLIC_SITE_URL || "https://kidsarabicacademy.com";
+  const baseUrl = process.env.NEXT_PUBLIC_SITE_URL || "https://www.arabickidsacademy.com";
 
   return {
     rules: {
diff --git a/src/app/sitemap.ts b/src/app/sitemap.ts
index 4383ab9..ecb7ddc 100644
--- a/src/app/sitemap.ts
+++ b/src/app/sitemap.ts
@@ -2,7 +2,7 @@ import { MetadataRoute } from "next";
 import { locales } from "@/lib/localization";
 
 export default function sitemap(): MetadataRoute.Sitemap {
-  const baseUrl = process.env.NEXT_PUBLIC_SITE_URL || "https://kidsarabicacademy.com";
+  const baseUrl = process.env.NEXT_PUBLIC_SITE_URL || "https://www.arabickidsacademy.com";
 
   const publicRoutes = ["", "/login", "/privacy", "/terms"];
 
