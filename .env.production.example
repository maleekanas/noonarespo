# =============================================================================
# KIDS ARABIC ACADEMY - PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env.production on your deployment server (e.g. AWS, Vercel, Railway, Render).
# Fill in the real commercial secrets before pointing your external domain to the platform.

# -----------------------------------------------------------------------------
# 1. CORE APPLICATION & DOMAIN CONFIGURATION
# -----------------------------------------------------------------------------
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://kidsarabicacademy.com
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Set to "true" on public commercial domains to hide the development persona switcher
NEXT_PUBLIC_HIDE_DEMO_SWITCHER=true

# -----------------------------------------------------------------------------
# 2. CRYPTOGRAPHIC SECURITY & SESSION ENCRYPTION
# -----------------------------------------------------------------------------
# Generate a strong 64-character random string (e.g. openssl rand -base64 48)
SESSION_SECRET=your_super_strong_cryptographic_hmac_secret_here_minimum_32_chars

# -----------------------------------------------------------------------------
# 3. PRODUCTION MANAGED DATABASE (PostgreSQL)
# -----------------------------------------------------------------------------
# Connection string to your managed PostgreSQL instance (Supabase, Neon, AWS RDS, CockroachDB)
# Run `npx prisma migrate deploy` during deployment pipeline
DATABASE_URL="postgresql://kaa_prod_user:StrongPassword123!@aws-rds-postgresql.example.com:5432/kids_arabic_academy_prod?schema=public&sslmode=require&connection_limit=20"

# Direct connection string for Prisma migrations (if using PgBouncer / Connection Pooler)
DIRECT_URL="postgresql://kaa_prod_user:StrongPassword123!@aws-rds-postgresql.example.com:5432/kids_arabic_academy_prod?schema=public&sslmode=require"

# -----------------------------------------------------------------------------
# 4. COMMERCIAL PAYMENT GATEWAYS (Stripe / Mollie / PayPal)
# -----------------------------------------------------------------------------
# Stripe Production Keys
STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key
STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_live_stripe_webhook_signing_secret

# Optional: Mollie (European iDEAL / Bancontact payments for Dutch & EU families)
MOLLIE_API_KEY=live_your_mollie_live_api_key

# Optional: PayPal Commerce Platform
PAYPAL_CLIENT_ID=your_paypal_live_client_id
PAYPAL_CLIENT_SECRET=your_paypal_live_client_secret

# -----------------------------------------------------------------------------
# 5. PRIVATE CLOUD STORAGE (COPPA/GDPR Encrypted Child Voice & Media)
# -----------------------------------------------------------------------------
# AWS S3 or Cloudflare R2 bucket with Private (No Public Read) ACL
AWS_REGION=me-central-1
AWS_S3_BUCKET=kids-arabic-academy-vault-prod
AWS_ACCESS_KEY_ID=AKIA_YOUR_PROD_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=your_prod_aws_secret_access_key

# -----------------------------------------------------------------------------
# 6. AI CONVERSATIONAL TUTOR (Faseeh)
# -----------------------------------------------------------------------------
# Google Gemini Pro / Flash or OpenAI GPT-4o API Key
GEMINI_API_KEY=AIzaSy_your_production_gemini_api_key
# Or OpenAI:
# OPENAI_API_KEY=sk-proj-your_production_openai_api_key

# -----------------------------------------------------------------------------
# 7. LIVE VIRTUAL CLASSROOM & VIDEO CONFERENCING
# -----------------------------------------------------------------------------
# Zoom Server-to-Server OAuth (for automatic class meeting generation)
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# Microsoft Teams / Office 365 Education Tenant (Optional alternative)
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# 8. MULTI-CHANNEL NOTIFICATIONS (Transactional Email & SMS & WhatsApp)
# -----------------------------------------------------------------------------
# Transactional Email (Resend or Postmark or AWS SES)
RESEND_API_KEY=re_your_live_resend_api_key
FROM_EMAIL="Arabic Kids Academy <notifications@kidsarabicacademy.com>"

# Cloud WhatsApp Business API (Meta Developer Console)
WHATSAPP_PHONE_NUMBER_ID=your_meta_whatsapp_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_whatsapp_system_user_token

# SMS Gateway (Twilio for class start reminders)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
